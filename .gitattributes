# Default text normalization
* text=auto

# Build and shell scripts (Unix)
/mvnw text eol=lf
*.sh text eol=lf

# Java / Spring source and config files
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Windows scripts
*.cmd text eol=crlf
*.bat text eol=crlf
